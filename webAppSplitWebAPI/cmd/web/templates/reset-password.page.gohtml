{{template "base" .}}

{{define "title"}}
    Reset password
{{end}}

{{define "content"}}
    <div class="container d-flex justify-content-center mt-5">
        <div class="w-100 mb-5" style="max-width: 400px;">
            {{if .Error}}
                <div class="alert alert-danger text-center">{{.Error}}</div>
                <p class="text-center"><a href="/forgot-password">Request a new reset link</a></p>
            {{else}}
                <div class="alert d-none text-center" id="reset-password-messages"></div>
                <form id="reset_password_form"
                    class="card p-4 shadow-sm needs-validation"
                    novalidate>
                    <h2 class="mt-2 text-center mb-4">Reset password</h2>
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control" id="password" required autocomplete="new-password">
                        <div class="field-error d-none text-danger small mt-1" id="err-password"></div>
                    </div>
                    <div class="mb-3">
                        <label for="verify-password" class="form-label">Verify Password</label>
                        <input type="password" class="form-control" id="verify-password" required autocomplete="new-verify-password">
                    </div>
                    <div class="d-grid">
                        <button id="reset_btn" type="submit" class="btn btn-primary">Reset password</button>
                    </div>
                </form>
            {{end}}
        </div>
    </div>
{{end}}

{{define "js"}}
    {{if not .Error}}
        <script>
            let csrfToken = '{{index .StringMap "csrf_token"}}';
            let deviceId = '{{index .StringMap "device_id"}}';
            let resetEmail = '{{index .Data "email"}}';
            let signedUrl = '{{index .Data "signed_url"}}';
        </script>
        <script src="/static/js/reset_password.js"></script>
    {{end}}
{{end}}
