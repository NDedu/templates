{{template "base" .}}

{{define "title"}}
    User
{{end}}

{{define "content"}}

    <div id="messages" class="d-flex justify-content-center">
        <div id="messages-inner" class="d-none alert text-center" style="max-width: 400px; width: 100%;"></div>
    </div>

    <h2 class="mt-5 mb-3">User</h2>

    <span id="inactive" class="badge bg-danger d-none">Inactive</span>
    <span id="active" class="badge bg-success d-none">Active</span>
    <hr>

    <div class="mb-3">
        <img id="profile-image" src="/static/img/no_picture.jpg" alt="Profile picture" class="invisible" style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%;">
        <div class="mt-2">
            <label for="profile-image-input" class="btn btn-outline-secondary btn-sm">Upload picture</label>
            <input type="file" id="profile-image-input" accept="image/jpeg,image/png,image/gif,image/webp" class="d-none" onchange="uploadProfileImage(this)">
        </div>
    </div>

    <table class="table table-borderless" style="max-width: 500px;">
        <tbody>
            <tr>
                <td class="fw-bold" style="width: 120px;">First Name:</td>
                <td>
                    <span id="first-name" class="user-display"></span>
                    <input type="text" id="first-name-input" class="form-control user-edit d-none">
                    <div class="field-error d-none text-danger small mt-1" id="err-first_name"></div>
                </td>
            </tr>
            <tr>
                <td class="fw-bold">Last Name:</td>
                <td>
                    <span id="last-name" class="user-display"></span>
                    <input type="text" id="last-name-input" class="form-control user-edit d-none">
                    <div class="field-error d-none text-danger small mt-1" id="err-last_name"></div>
                </td>
            </tr>
            <tr>
                <td class="fw-bold">Email:</td>
                <td>
                    <span id="email" class="user-display"></span>
                    <input type="email" id="email-input" class="form-control user-edit d-none">
                    <div class="field-error d-none text-danger small mt-1" id="err-email"></div>
                </td>
            </tr>
            <tr>
                <td class="fw-bold">Role:</td>
                <td>
                    <span id="role" class="user-display"></span>
                    <select id="role-input" class="form-select user-edit d-none">
                        <option value="user">user</option>
                        <option value="editor">editor</option>
                        <option value="admin">admin</option>
                    </select>
                    <div class="field-error d-none text-danger small mt-1" id="err-role"></div>
                </td>
            </tr>
            <tr>
                <td class="fw-bold">Status:</td>
                <td>
                    <span id="status" class="user-display"></span>
                    <select id="status-input" class="form-select user-edit d-none">
                        <option value="1">Active</option>
                        <option value="0">Inactive</option>
                    </select>
                </td>
            </tr>
        </tbody>
    </table>
    <a href="#!" id="reset-password-link" onclick="resetPassword()" style="font-size: 0.9em;">Reset user's password</a>
    <hr>
    <a class="btn btn-info" href="/admin/all-users">Back</a>
    <a class="btn btn-success" id="edit-btn" href="#!" onclick="toggleEdit()">Edit</a>
    <a class="btn btn-danger" id="delete-cancel-btn" href="#!" onclick="deleteUser()">Delete</a>

    <div class="modal fade" id="save-modal" tabindex="-1" aria-labelledby="saveModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="saveModalLabel">Confirm Changes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to save the changes?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" id="confirm-save-btn" onclick="saveUser()">Save</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="delete-modal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this user?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirm-delete-btn" onclick="confirmDeleteUser()">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="reset-password-modal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="resetPasswordModalLabel">Reset Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="reset-password-input" class="form-label">Password</label>
                        <input type="password" class="form-control" id="reset-password-input" autocomplete="new-password" minlength="8" maxlength="72">
                        <div class="field-error d-none text-danger small mt-1" id="err-password"></div>
                    </div>
                    <div class="mb-3">
                        <label for="reset-confirm-password-input" class="form-label">Confirm Password</label>
                        <input type="password" class="form-control" id="reset-confirm-password-input" autocomplete="new-password">
                        <div class="field-error d-none text-danger small mt-1" id="err-confirm_password"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning" id="confirm-reset-password-btn" onclick="confirmResetPassword()">Reset Password</button>
                </div>
            </div>
        </div>
    </div>

{{end}}

{{define "js"}}
    <script>
        let csrfToken = '{{index .StringMap "csrf_token"}}';
        let deviceId = '{{index .StringMap "device_id"}}';
        let currentUserUUID = '{{.UserUUID}}';
    </script>
    <script src="/static/js/user.js"></script>
{{end}}
