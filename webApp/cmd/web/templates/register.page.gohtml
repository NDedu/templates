{{template "base" .}}

{{define "title"}}
    Register
{{end}}

{{define "content"}}
    <div class="container d-flex justify-content-center mt-5">
        <div class="w-100 mb-5" style="max-width: 400px;">
            <div class="alert d-none text-center" id="register-messages"></div>
            <form id="register_form"
                class="card p-4 shadow-sm needs-validation"
                novalidate>
                <h2 class="mt-2 text-center mb-4">Register</h2>
                <div class="mb-3">
                    <label for="first-name" class="form-label">First Name</label>
                    <input type="text" class="form-control" id="first-name" required autocomplete="given-name">
                    <div class="field-error d-none text-danger small mt-1" id="err-first_name"></div>
                </div>
                <div class="mb-3">
                    <label for="last-name" class="form-label">Last Name</label>
                    <input type="text" class="form-control" id="last-name" required autocomplete="family-name">
                    <div class="field-error d-none text-danger small mt-1" id="err-last_name"></div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" required autocomplete="email-new">
                    <div class="field-error d-none text-danger small mt-1" id="err-email"></div>
                </div>
                <div class="mb-3">
                    <label for="confirm-email" class="form-label">Confirm Email</label>
                    <input type="email" class="form-control" id="confirm-email" required autocomplete="confirm-email-new">
                    <div class="field-error d-none text-danger small mt-1" id="err-confirm_email"></div>
                </div>
                <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" class="form-control" id="password" required autocomplete="current-password">
                    <div class="field-error d-none text-danger small mt-1" id="err-password"></div>
                </div>
                <div class="mb-4">
                    <label for="confirm-password" class="form-label">Confirm Password</label>
                    <input type="password" class="form-control" id="confirm-password" required autocomplete="confirm-password-new">
                    <div class="field-error d-none text-danger small mt-1" id="err-confirm_password"></div>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Register</button>
                </div>
            </form>
        </div>
    </div>
{{end}}

{{define "js"}}
    <script>
        let csrfToken = '{{index .StringMap "csrf_token"}}';
        let deviceId = '{{index .StringMap "device_id"}}';
    </script>
    <script src="/static/js/register.js"></script>
{{end}}
